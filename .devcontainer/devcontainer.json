{
  "name": "FleetOps SRE Lab (free Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "postCreateCommand": "python -m pip install --user -r requirements-dev.txt",
  "postStartCommand": "bash -lc 'nohup python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 > /tmp/fleetops-uvicorn.log 2>&1 &'",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "FleetOps API + Dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteEnv": {
    "FLEETOPS_DB": "${containerWorkspaceFolder}/.fleetops-codespaces.sqlite3"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
